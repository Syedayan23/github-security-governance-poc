# GitHub Authentication & Repository Settings
# Note: Never commit your actual .env file. Copy this file to .env and fill in your values.

# GitHub Personal Access Token (classic or fine-grained)
# Required permissions:
# - Classic PAT: 'repo' or 'security_events' (read access)
# - Fine-Grained PAT:
#     - Read access to "Dependabot alerts"
#     - Read access to "Code scanning alerts"
#     - Read access to "Metadata"
GITHUB_TOKEN=ghp_your_personal_access_token_here

# GitHub repository owner (individual username or organization)
GITHUB_OWNER=your_github_username

# GitHub repository name (e.g. github-security-governance-poc)
GITHUB_REPO=github-security-governance-poc

# GitHub Webhook Secret (used to verify HMAC-SHA256 signatures in X-Hub-Signature-256)
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# Backend configuration
DATABASE_PATH=sqlite:///./governance_security.db
PORT=8000
HOST=0.0.0.0
